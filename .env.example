# .env.example; copy to .env and fill these ONLY on the device running the service.
# Never commit .env. Never paste the token into a prompt or chat.
TELEGRAM_BOT_TOKEN=REPLACE_LOCALLY
TELEGRAM_CHAT_ID=REPLACE_LOCALLY
# "paper" = manual paper-trade bookkeeping (not a broker setting). Only "paper" is accepted in this version; "real" is a startup error.
CSP_ENV=paper
CSP_DRY_RUN=true
CSP_TZ=America/Chicago
CSP_DATABASE_URL=sqlite:///./data/csp_alerts.sqlite3
CSP_STOCKPILE_ROOT=./third_party/stockpile
CSP_DATA_PROVIDER=yahoo
# Must be true. false is a startup ERROR, not a way to enable brokerage integration.
CSP_DISABLE_BROKER_ACCESS=true
CSP_AI_ENABLED=false
CSP_LOG_LEVEL=INFO
# Optional later: independent AI service key in a local secret store, NOT this template.
# Local read-only dashboard (python -m csp_dashboard). Loopback only (127.0.0.1). Generate the value with
# `.venv\Scripts\python -m csp_dashboard hash-password` and paste it here in .env only. Never commit it.
CSP_DASHBOARD_PASSWORD_HASH=REPLACE_LOCALLY
CSP_DASHBOARD_PORT=8765
